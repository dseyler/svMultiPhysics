<?xml version="1.0" encoding="UTF-8" ?>
<svMultiPhysicsFile version="0.1">

<!--
  Phase 1 of 2: prestrain the imaged LV geometry at 10 mmHg by imprinting a
  deformation gradient (Gee, Forster & Wall 2010, modified updated Lagrangian
  formulation). The geometry never moves. The run is a pseudo-transient
  continuation: every step starts from rest under the full load, takes one
  Newton iteration, and accumulates the displacement it reaches into the
  prestrain. The printed "max update" tends to zero as the state converges.

  The load is a dead load on the imaged surface (Follower_pressure_load false),
  as in the paper. The last result_NNN.vtu carries the prestrain as the point
  array Prestrain_displacement, the nodal field U with F = I + Grad(U + u),
  which forward.xml reads.

  With Pseudo_transient_adaptive_dt the pseudo time step grows by the ratio of
  successive first residuals as the state approaches equilibrium, and the
  residual is at round-off after 11 steps from dt = 1e-2 (the second and third
  steps overshoot and are corrected by the same rule). At a fixed dt the run is
  a dynamic relaxation and converges at the rate of the softest mode, about
  0.96 per step at dt = 1e-2, some 160 steps.
-->

<GeneralSimulationParameters>
  <Continue_previous_simulation> 0 </Continue_previous_simulation>
  <Number_of_spatial_dimensions> 3 </Number_of_spatial_dimensions>
  <Number_of_time_steps> 12 </Number_of_time_steps>
  <Time_step_size> 1e-2 </Time_step_size>
  <Spectral_radius_of_infinite_time_step> 0.50 </Spectral_radius_of_infinite_time_step>
  <Searched_file_name_to_trigger_stop> STOP_SIM </Searched_file_name_to_trigger_stop>

  <Save_results_to_VTK_format> 1 </Save_results_to_VTK_format>
  <Name_prefix_of_saved_VTK_files> result </Name_prefix_of_saved_VTK_files>
  <Save_results_in_folder> prestrain </Save_results_in_folder>
  <Increment_in_saving_VTK_files> 1 </Increment_in_saving_VTK_files>
  <Start_saving_after_time_step> 1 </Start_saving_after_time_step>

  <Increment_in_saving_restart_files> 1000 </Increment_in_saving_restart_files>
  <Convert_BIN_to_VTK_format> 0 </Convert_BIN_to_VTK_format>

  <Verbose> 1 </Verbose>
  <Warning> 1 </Warning>
  <Debug> 0 </Debug>
</GeneralSimulationParameters>

<Add_mesh name="msh" >
  <Mesh_file_path> mesh/mesh-complete.mesh.vtu </Mesh_file_path>

  <Add_face name="endo">
      <Face_file_path> mesh/mesh-surfaces/endo.vtp </Face_file_path>
  </Add_face>
  <Add_face name="epi">
      <Face_file_path> mesh/mesh-surfaces/epi.vtp </Face_file_path>
  </Add_face>
  <Add_face name="top">
      <Face_file_path> mesh/mesh-surfaces/top.vtp </Face_file_path>
  </Add_face>

  <Fiber_direction_file_path> mesh/fibersLongCells.vtu </Fiber_direction_file_path>
  <Fiber_direction_file_path> mesh/fibersSheetCells.vtu </Fiber_direction_file_path>

  <Mesh_scale_factor> 100.0 </Mesh_scale_factor> <!-- Convert from m to cm -->
</Add_mesh>

<!-- Using cgs units -->
<Add_equation type="struct" >
   <Coupled> true </Coupled>
   <Min_iterations> 3 </Min_iterations>
   <Max_iterations> 20 </Max_iterations>
   <Tolerance> 1e-10 </Tolerance>

   <Prestrain> true </Prestrain>
   <Pseudo_transient_adaptive_dt> true </Pseudo_transient_adaptive_dt>
   <Pseudo_transient_max_dt> 100.0 </Pseudo_transient_max_dt>

   <Density> 1.0 </Density>                           <!-- g/cm^3 -->
   <Elasticity_modulus> 1.0e6 </Elasticity_modulus>   <!-- dyne/cm^2 -->
   <Poisson_ratio> 0.483333 </Poisson_ratio>

   <Constitutive_model type="HolzapfelOgden">
     <a> 590.0 </a>                                   <!-- dyne/cm^2 -->
     <b> 8.023 </b>                                   <!-- no units -->
     <a4f> 184720.0 </a4f>
     <b4f> 16.026 </b4f>
     <a4s> 24810.0 </a4s>
     <b4s> 11.12 </b4s>
     <afs> 2160.0 </afs>
     <bfs> 11.436 </bfs>
     <k> 100.0 </k>
   </Constitutive_model>

   <Dilational_penalty_model> ST91 </Dilational_penalty_model>
   <Penalty_parameter> 1.0e7 </Penalty_parameter>

   <Output type="Spatial" >
     <Displacement> true </Displacement>
     <Jacobian> true </Jacobian>
     <Stress> true </Stress>
     <Cauchy_stress> true </Cauchy_stress>
     <Def_grad> true </Def_grad>
     <VonMises_stress> true </VonMises_stress>
   </Output>

   <LS type="GMRES" >
      <Linear_algebra type="fsils" >
         <Preconditioner> fsils </Preconditioner>
      </Linear_algebra>
      <Tolerance> 1e-16 </Tolerance>
      <Max_iterations> 1000 </Max_iterations>
      <Krylov_space_dimension> 50 </Krylov_space_dimension>
   </LS>

   <Add_BC name="top" >
      <Type> Dirichlet </Type>
      <Value> 0.0 </Value>
   </Add_BC>

   <!-- 10 mmHg = 13332.2 dyne/cm^2, applied in full from the first step as a
        dead load on the imaged endocardium -->
   <Add_BC name="endo" >
      <Type> Neu </Type>
      <Time_dependence> Steady </Time_dependence>
      <Value> 13332.2 </Value>
      <Follower_pressure_load> false </Follower_pressure_load>
   </Add_BC>

</Add_equation>

</svMultiPhysicsFile>
